# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Use the SAME value for Next.js and the Python service.
MEDIA_BACKEND_KEY=replace-with-a-random-secret-of-at-least-32-characters
MEDIA_BACKEND_URL=http://127.0.0.1:8787
# Optional TikTok session for a private, single-user instance only.
# Do not enable for a public/multi-user deployment.
# FETCHLY_PRIVATE_MODE=1
# TIKTOK_COOKIES_FILE=/run/tiktok-cookies.txt
MAX_DOWNLOAD_BYTES=524288000

# Optional admin-only staged engine updates. Generate a separate secret (32+ characters).
# FETCHLY_ADMIN_KEY=your-separate-admin-secret
FETCHLY_ENGINE_DIR=/app/engines
